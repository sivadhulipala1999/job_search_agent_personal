# ==============================================================================
# Job Search Agent Configuration
# ==============================================================================

# Search Configurations
TARGET_COUNTRY="USA"

# LLM Configurations (Use any OpenAI-compatible provider)
LLM_MODEL="gpt-4o-mini"
# LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_api_key_here"

# (Fallback options if the above are unset)
# OPENAI_BASE_URL=
# Fallback model when Free Tier rate limits are exhausted (e.g. gemini-1.5-flash)
# FALLBACK_LLM_MODEL=gemini-1.5-flash-8b

# Maximum scraped jobs per run (limits OpenAI API spend)
MAX_JOBS_LIMIT=50

# Application Generation Threshold (0-100)
# Automatically draft targeted cover letters for jobs scoring above this threshold
APPLICATION_THRESHOLD=90

# Optional Email Notifications
# If these are provided, the script will automatically email you the daily markdown report!
# SMTP_EMAIL="your_email@gmail.com"
# SMTP_PASSWORD="your_app_password"
# RECIPIENT_EMAIL="your_email@gmail.com"
